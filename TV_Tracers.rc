IDR_MAINFRAME MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "В&ідкрити...\tCtrl+O",        ID_FILE_OPEN
        MENUITEM "З&акрити",                    ID_FILE_CLOSE
        MENUITEM "&Зберегти\tCtrl+S",           ID_FILE_SAVE
        MENUITEM "З&берегти як...",             ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Друк...\tCtrl+P",            ID_FILE_PRINT
        MENUITEM "Пере&гляд друку",             ID_FILE_PRINT_PREVIEW
        MENUITEM "Властивості п&ринтера...",    ID_FILE_PRINT_SETUP
        MENUITEM "Вла&стивості сторінки",       ID_FILE_PAGESETUP
        MENUITEM SEPARATOR
        MENUITEM "Останні&й використаний файл", ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Вихід\tAlt+F4",              ID_APP_EXIT
    END
    POPUP "&Вигляд"
    BEGIN
        MENUITEM "С&трока інструментів",        ID_VIEW_TOOLBAR
        MENUITEM "&Строка стану",               ID_VIEW_STATUS_BAR
    END
    POPUP "&Налаштування"
    BEGIN
        MENUITEM "&Концентратор",               ID_DEVICE_SETUP
        MENUITEM "&Вуличний світильник",        ID_LAMPS_SETUP
        MENUITEM SEPARATOR
        MENUITEM "&Оператори",                  ID_COBFIG_OPERATOR
        MENUITEM "&Номер робочого місця",       ID_SELECT_PC
        MENUITEM "&З'єднання з базою даних",    ID_CONFIG_DB
    END
    POPUP "&Керування"
    BEGIN
        MENUITEM "&Зміна оператору",            ID_SELECT_OPERATOR
    END
    POPUP "&Звіти"
    BEGIN
        MENUITEM "&Системи",                    ID_ACCOUNTS_SYSTEM
        MENUITEM SEPARATOR
        MENUITEM "&Тест LQI",                   ID_TEST_LQI
        MENUITEM "&Видалення звітів",           ID_ACCOUNTS_CLEAR
    END
    POPUP "Ві&кна"
    BEGIN
        MENUITEM "&Каскадом",                   ID_WINDOW_CASCADE
        MENUITEM "&Горизонтально",              ID_WINDOW_TILE_HORZ
        MENUITEM "&Вертикально",                ID_WINDOW_TILE_VERT
    END
    POPUP "&Допомога"
    BEGIN
        MENUITEM "&Розділи довідки",            ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "&О StreetLights...",          ID_APP_ABOUT
    END
END


