    CONTROL         "DateTimePicker1",IDC_TIME_MAX,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | DTS_SHOWNONE | WS_TABSTOP | 0x8,99,53,75,15
    LTEXT           "> =",IDC_STATIC,7,8,40,14
    LTEXT           "< =",IDC_STATIC,7,38,40,14
END


